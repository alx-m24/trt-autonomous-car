<?xml version='1.0'?>
<sdf version='1.6'>
  <model name='my_car'>
    <static>false</static>

    <!-- Model origin is at ground-contact center (base footprint) -->
    <link name='chassis'>
      <pose>0 0 0.08 0 0 0</pose>
      <inertial>
        <mass>1.5</mass>
        <inertia>
          <ixx>0.01</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.01</iyy>
          <iyz>0.0</iyz>
          <izz>0.02</izz>
        </inertia>
      </inertial>
      <collision name='collision'>
        <geometry>
          <box>
            <size>0.30 0.18 0.06</size>
          </box>
        </geometry>
      </collision>
      <visual name='visual'>
        <geometry>
          <box>
            <size>0.30 0.18 0.06</size>
          </box>
        </geometry>
      </visual>

      <!-- Camera sensor attached to chassis -->
      <sensor type='camera' name='front_camera'>
        <pose>0.13 0 0.05 0 0.349 0</pose>
        <update_rate>30</update_rate>
        <camera name='front_camera'>
          <horizontal_fov>1.3962634</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.02</near>
            <far>300</far>
          </clip>
        </camera>
        <plugin name='camera_controller' filename='libgazebo_ros_camera.so'>
          <frame_name>camera_optical_frame</frame_name>
          <image_topic_name>/camera/image_raw</image_topic_name>
          <camera_info_topic_name>/camera/camera_info</camera_info_topic_name>
        </plugin>
      </sensor>
    </link>

    <!-- Dummy link for camera optical frame naming consistency -->
    <link name='camera_optical_frame'>
      <pose>0.13 0 0.13 -1.5708 0 -1.5708</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>1e-6</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>1e-6</iyy>
          <iyz>0.0</iyz>
          <izz>1e-6</izz>
        </inertia>
      </inertial>
    </link>
    <joint name='camera_optical_joint' type='fixed'>
      <parent>chassis</parent>
      <child>camera_optical_frame</child>
    </joint>

    <!-- Steering wheel (optional but expected by ackermann plugin) -->
    <link name='steering_wheel'>
      <pose>0.10 0 0.16 0 0 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>1e-6</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>1e-6</iyy>
          <iyz>0.0</iyz>
          <izz>1e-6</izz>
        </inertia>
      </inertial>
    </link>
    <joint name='steering_joint' type='revolute'>
      <parent>chassis</parent>
      <child>steering_wheel</child>
      <pose>0.10 0 0.16 0 0 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-7.85</lower>
          <upper>7.85</upper>
        </limit>
        <dynamics>
          <damping>1.0</damping>
        </dynamics>
      </axis>
    </joint>

    <!-- Wheels (radius 0.05, width 0.04); rotate cylinder so it spins about X -->
    <link name='rear_left_wheel'>
      <pose>-0.12 0.11 0.05 0 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.0001</iyy>
          <iyz>0.0</iyz>
          <izz>0.0002</izz>
        </inertia>
      </inertial>
      <collision name='collision'>
        <pose>0 0 0 0 1.5708 0</pose>
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name='visual'>
        <pose>0 0 0 0 1.5708 0</pose>
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
      </visual>
    </link>

    <joint name='rear_left_wheel_joint' type='revolute'>
      <parent>chassis</parent>
      <child>rear_left_wheel</child>
      <pose>-0.12 0.11 0.05 0 0 0</pose>
      <axis>
        <xyz>1 0 0</xyz>
        <dynamics>
          <friction>5.0</friction>
        </dynamics>
      </axis>
    </joint>

    <link name='rear_right_wheel'>
      <pose>-0.12 -0.11 0.05 0 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.0001</iyy>
          <iyz>0.0</iyz>
          <izz>0.0002</izz>
        </inertia>
      </inertial>
      <collision name='collision'>
        <pose>0 0 0 0 1.5708 0</pose>
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name='visual'>
        <pose>0 0 0 0 1.5708 0</pose>
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
      </visual>
    </link>

    <joint name='rear_right_wheel_joint' type='revolute'>
      <parent>chassis</parent>
      <child>rear_right_wheel</child>
      <pose>-0.12 -0.11 0.05 0 0 0</pose>
      <axis>
        <xyz>1 0 0</xyz>
        <dynamics>
          <friction>5.0</friction>
        </dynamics>
      </axis>
    </joint>

    <!-- Front wheels use universal joints (steer about Z, roll about X) like the official demo -->
    <link name='front_left_wheel'>
      <pose>0.12 0.11 0.05 0 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.0001</iyy>
          <iyz>0.0</iyz>
          <izz>0.0002</izz>
        </inertia>
      </inertial>
      <collision name='collision'>
        <pose>0 0 0 0 1.5708 0</pose>
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.5</mu>
              <mu2>0.5</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name='visual'>
        <pose>0 0 0 0 1.5708 0</pose>
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
      </visual>
    </link>

    <joint name='front_left_combined_joint' type='universal'>
      <parent>chassis</parent>
      <child>front_left_wheel</child>
      <pose>0.12 0.11 0.05 0 0 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-0.6</lower>
          <upper>0.6</upper>
        </limit>
      </axis>
      <axis2>
        <xyz>1 0 0</xyz>
        <dynamics>
          <friction>5.0</friction>
        </dynamics>
      </axis2>
    </joint>

    <link name='front_right_wheel'>
      <pose>0.12 -0.11 0.05 0 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.0001</iyy>
          <iyz>0.0</iyz>
          <izz>0.0002</izz>
        </inertia>
      </inertial>
      <collision name='collision'>
        <pose>0 0 0 0 1.5708 0</pose>
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.5</mu>
              <mu2>0.5</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name='visual'>
        <pose>0 0 0 0 1.5708 0</pose>
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
      </visual>
    </link>

    <joint name='front_right_combined_joint' type='universal'>
      <parent>chassis</parent>
      <child>front_right_wheel</child>
      <pose>0.12 -0.11 0.05 0 0 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-0.6</lower>
          <upper>0.6</upper>
        </limit>
      </axis>
      <axis2>
        <xyz>1 0 0</xyz>
        <dynamics>
          <friction>5.0</friction>
        </dynamics>
      </axis2>
    </joint>

  </model>
</sdf>
