<?xml version="1.0"?>
<sdf version="1.6">
  <model name="track_race">
    <static>true</static>
    <link name="link">

      <!-- Collision: the full mesh (mm -> scale 0.001), re-centred. -->
      <collision name="col">
        <pose>-1.2132 0.0694 0 0 0 0</pose>
        <geometry>
          <mesh><uri>model://track_race/meshes/OMar.stl</uri><scale>0.001 0.001 0.001</scale></mesh>
        </geometry>
        <max_contacts>10</max_contacts>
        <surface>
          <contact><ode/></contact>
          <friction><ode/><torsional><ode/></torsional></friction>
          <bounce/>
        </surface>
      </collision>

      <!-- Visuals: one per colour group (split by SolidWorks face colour). -->
      <visual name="surround">
        <pose>-1.2132 0.0694 0 0 0 0</pose>
        <geometry>
          <mesh><uri>model://track_race/meshes/surround.stl</uri><scale>0.001 0.001 0.001</scale></mesh>
        </geometry>
        <material>
          <ambient>0.45 0.55 0.42 1</ambient>
          <diffuse>0.75 0.85 0.69 1</diffuse>
        </material>
      </visual>

      <visual name="road">
        <pose>-1.2132 0.0694 0 0 0 0</pose>
        <geometry>
          <mesh><uri>model://track_race/meshes/road.stl</uri><scale>0.001 0.001 0.001</scale></mesh>
        </geometry>
        <material>
          <script>
            <uri>model://track_race/materials/scripts</uri>
            <uri>model://track_race/materials/textures</uri>
            <name>Track/CustomRoad</name>
          </script>
        </material>
      </visual>

      <visual name="lines">
        <pose>-1.2132 0.0694 0 0 0 0</pose>
        <geometry>
          <mesh><uri>model://track_race/meshes/lines.stl</uri><scale>0.001 0.001 0.001</scale></mesh>
        </geometry>
        <material>
          <ambient>0.9 0.9 0.9 1</ambient>
          <diffuse>0.97 0.97 0.97 1</diffuse>
        </material>
      </visual>

      <self_collide>0</self_collide>
      <enable_wind>0</enable_wind>
      <kinematic>0</kinematic>
    </link>
  </model>
</sdf>
